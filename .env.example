# Copy to .env and fill in. .env is git-ignored.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Optional: a Scrum board id (from the board URL .../boards/123). Otherwise the first Scrum board is used.
JIRA_BOARD_ID=
JIRA_PROJECT_KEY=
# Optional: custom field ids (they differ per site)
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_FLAG_FIELD=customfield_10021
# PORT=8000
